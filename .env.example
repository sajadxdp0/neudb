# neuDB environment examples. Copy to .env for Docker Compose, or pass this file
# to a process that supports --env-file (for example, uvicorn --env-file .env).
# The Python library and CLI do not automatically load .env files.

# CLI database directory (default when unset: ./neudb_data).
NEUDB_DB=neudb_data/

# API database directory (default when unset: ./neudb_api_data).
# Docker Compose overrides this to /data inside the container.
NEUDB_API_DB=neudb_api_data/

# Required API credential. Leave empty to fail closed; generate a long random
# value before starting the API. Clients send it in the X-API-Key header.
NEUDB_API_KEY=

# Comma-separated browser origins allowed to call the API. No wildcard is needed
# for the bundled local dashboard.
NEUDB_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Maximum HTTP request body size in bytes (minimum: 1024; default: 1048576).
NEUDB_MAX_REQUEST_BYTES=1048576
